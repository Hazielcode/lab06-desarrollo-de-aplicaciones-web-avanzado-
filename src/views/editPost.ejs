<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Editar Aventura | Rancho de Haziel</title>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/css/materialize.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600;700&family=Quicksand:wght@400;600;700&display=swap" rel="stylesheet">
  
  <style>
    body {
      background-color: #fff3e0; /* Naranja/Amarillo clarito (Miel/Fósforo) */
      font-family: 'Quicksand', sans-serif;
      background-image: radial-gradient(#ffe0b2 10%, transparent 10%);
      background-size: 20px 20px;
    }
    nav {
      background-color: #ff9800 !important; /* Naranja vibrante */
      box-shadow: 0 4px 15px rgba(255, 152, 0, 0.4);
    }
    .brand-logo { font-family: 'Fredoka', sans-serif; font-weight: 700; }
    .card {
      border-radius: 25px;
      border: 3px solid #ffb74d;
      box-shadow: 0 10px 30px rgba(255, 152, 0, 0.15);
    }
    .card-title {
      font-family: 'Fredoka', sans-serif;
      font-weight: 700;
      color: #e65100 !important;
      font-size: 28px !important;
      margin-bottom: 30px !important;
    }
    .btn {
      font-family: 'Fredoka', sans-serif;
      border-radius: 25px;
      background-color: #ffa726 !important;
    }
    .btn:hover { background-color: #ffb74d !important; }
    .btn.grey { background-color: #b0bec5 !important; }
    .input-field input[type=text]:focus + label, .materialize-textarea:focus + label {
      color: #ff9800 !important;
    }
    .input-field input[type=text]:focus, .materialize-textarea:focus {
      border-bottom: 2px solid #ff9800 !important;
      box-shadow: 0 1px 0 0 #ff9800 !important;
    }
  </style>
</head>
<body>

  <!-- Navbar -->
  <nav>
    <div class="nav-wrapper">
      <a href="/posts" class="brand-logo center">Rancho de Haziel</a>
      <ul class="left">
        <li><a href="/posts"><i class="material-icons">arrow_back</i></a></li>
      </ul>
    </div>
  </nav>

  <div class="container" style="margin-top: 40px; margin-bottom: 40px;">
    <div class="row">
      <div class="col s12 m10 offset-m1 l8 offset-l2">
        <div class="card">
          <div class="card-content" style="padding: 40px;">
            <div class="center-align">
              <i class="material-icons" style="font-size: 48px; color: #ff9800;">auto_fix_high</i>
              <span class="card-title">Corregir Aventura</span>
            </div>

            <% if (error) { %>
              <div class="card-panel red lighten-4 red-text text-darken-4" style="border-radius: 10px;">
                <i class="material-icons tiny">error</i> <%= error %>
              </div>
            <% } %>

            <form action="/posts/edit/<%= post._id %>" method="POST">
              <div class="row">
                <div class="input-field col s12">
                  <i class="material-icons prefix">title</i>
                  <input type="text" id="title" name="title" value="<%= post.title %>" required minlength="5" maxlength="30">
                  <label for="title" class="active">Título del hallazgo (5-30 caracteres)</label>
                </div>
              </div>

              <div class="row">
                <div class="input-field col s12">
                  <i class="material-icons prefix">article</i>
                  <textarea id="content" name="content" class="materialize-textarea" required minlength="10"><%= post.content %></textarea>
                  <label for="content" class="active">Diario del rancho (mín. 10 caracteres)</label>
                </div>
              </div>

              <div class="row">
                <div class="input-field col s12">
                  <i class="material-icons prefix">image</i>
                  <input type="text" id="imageUrl" name="imageUrl" value="<%= post.imageUrl || '' %>">
                  <label for="imageUrl" class="active">Foto de la zona (URL opcional)</label>
                </div>
              </div>

              <div class="row">
                <div class="input-field col s12">
                  <i class="material-icons prefix">tag</i>
                  <input type="text" id="hashtags" name="hashtags" value="<%= post.hashtags ? post.hashtags.join(', ') : '' %>">
                  <label for="hashtags" class="active">Etiquetas (separadas por coma)</label>
                </div>
              </div>

              <div class="row" style="margin-top: 30px;">
                <div class="col s12 center-align">
                  <button type="submit" class="btn waves-effect waves-light btn-large">
                    <i class="material-icons left">save</i> Actualizar Registro
                  </button>
                  <a href="/posts" class="btn waves-effect waves-light grey btn-large" style="margin-left: 10px;">
                    <i class="material-icons left">close</i> Cancelar
                  </a>
                </div>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/js/materialize.min.js"></script>
</body>
</html>
