<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Registrar Ranchero | Rancho de Haziel</title>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/css/materialize.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600;700&family=Quicksand:wght@400;600;700&display=swap" rel="stylesheet">
  
  <style>
    body {
      background-color: #f3e5f5; /* Morado claro (Slime Bumm/Suertudo) */
      font-family: 'Quicksand', sans-serif;
      background-image: radial-gradient(#e1bee7 10%, transparent 10%);
      background-size: 20px 20px;
    }
    nav {
      background-color: #9c27b0 !important; /* Morado vibrante */
      box-shadow: 0 4px 15px rgba(156, 39, 176, 0.4);
    }
    .brand-logo { font-family: 'Fredoka', sans-serif; font-weight: 700; }
    .card {
      border-radius: 25px;
      border: 3px solid #ce93d8;
      box-shadow: 0 10px 30px rgba(156, 39, 176, 0.15);
    }
    .card-title {
      font-family: 'Fredoka', sans-serif;
      font-weight: 700;
      color: #6a1b9a !important;
      font-size: 28px !important;
      margin-bottom: 30px !important;
    }
    .btn {
      font-family: 'Fredoka', sans-serif;
      border-radius: 25px;
      background-color: #ab47bc !important;
    }
    .btn:hover { background-color: #ba68c8 !important; }
    .btn.grey { background-color: #b0bec5 !important; }
    .input-field input:focus + label {
      color: #9c27b0 !important;
    }
    .input-field input:focus {
      border-bottom: 2px solid #9c27b0 !important;
      box-shadow: 0 1px 0 0 #9c27b0 !important;
    }
  </style>
</head>
<body>

  <!-- Navbar -->
  <nav>
    <div class="nav-wrapper">
      <a href="/" class="brand-logo center">Rancho de Haziel</a>
      <ul class="left">
        <li><a href="/"><i class="material-icons">arrow_back</i></a></li>
      </ul>
    </div>
  </nav>

  <div class="container" style="margin-top: 40px; margin-bottom: 40px;">
    <div class="row">
      <div class="col s12 m10 offset-m1 l8 offset-l2">
        <div class="card">
          <div class="card-content" style="padding: 40px;">
            <div class="center-align">
              <i class="material-icons" style="font-size: 48px; color: #9c27b0;">person_add</i>
              <span class="card-title">Registrar Nuevo Ranchero</span>
            </div>

            <% if (error) { %>
              <div class="card-panel red lighten-4 red-text text-darken-4" style="border-radius: 10px;">
                <i class="material-icons tiny">error</i> <%= error %>
              </div>
            <% } %>

            <form action="/users/create" method="POST">
              <div class="row">
                <div class="input-field col s12 m6">
                  <i class="material-icons prefix">badge</i>
                  <input type="text" id="name" name="name" required>
                  <label for="name">Nombre</label>
                </div>
                <div class="input-field col s12 m6">
                  <input type="text" id="lastName" name="lastName" required>
                  <label for="lastName">Apellido</label>
                </div>
              </div>

              <div class="row">
                <div class="input-field col s12">
                  <i class="material-icons prefix">email</i>
                  <input type="email" id="email" name="email" required>
                  <label for="email">Correo Electrónico (VacvacMail)</label>
                </div>
              </div>

              <div class="row">
                <div class="input-field col s12 m6">
                  <i class="material-icons prefix">cake</i>
                  <input type="number" id="age" name="age" required min="18">
                  <label for="age">Edad (Mínimo 18)</label>
                </div>
                <div class="input-field col s12 m6">
                  <i class="material-icons prefix">phone</i>
                  <input type="text" id="phoneNumber" name="phoneNumber">
                  <label for="phoneNumber">Número de Comunicador</label>
                </div>
              </div>

              <div class="row">
                <div class="input-field col s12">
                  <i class="material-icons prefix">lock</i>
                  <input type="password" id="password" name="password" required minlength="8">
                  <label for="password">Contraseña (Mín. 8 caracteres)</label>
                </div>
              </div>

              <div class="row" style="margin-top: 30px;">
                <div class="col s12 center-align">
                  <button type="submit" class="btn waves-effect waves-light btn-large">
                    <i class="material-icons left">add_moderator</i> Inscribir Ranchero
                  </button>
                  <a href="/" class="btn waves-effect waves-light grey btn-large" style="margin-left: 10px;">
                    <i class="material-icons left">close</i> Cancelar
                  </a>
                </div>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/js/materialize.min.js"></script>
</body>
</html>
